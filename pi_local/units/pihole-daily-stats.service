# Installed disabled. Enable only with an explicit later go-live.
[Unit]
Description=Record the previous Europe/London Pi-hole aggregate
Documentation=file:/usr/local/share/doc/pi-local/pi-local-setup.md

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=pihole-daily-stats
StateDirectoryMode=0700
ConfigurationDirectory=pihole-daily-stats
LoadCredential=pihole_app_password:/etc/pihole-daily-stats/app-password
ExecStart=/usr/bin/python3 -m pi_local collect --config /etc/pihole-daily-stats/config.json
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/pihole-daily-stats
