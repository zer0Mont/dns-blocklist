# Installed disabled. Daily refresh, separate from the stock weekly cron.
[Unit]
Description=Daily Pi-hole gravity refresh after the midnight stats collection

[Timer]
OnCalendar=*-*-* 04:20:00 Europe/London
Persistent=true
AccuracySec=1min
Unit=pihole-daily-gravity.service

[Install]
WantedBy=timers.target
